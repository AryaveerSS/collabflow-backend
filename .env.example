# ================================
# CollabFlow Backend - Environment Variables
# Copy this file to .env and fill in your values
# ================================

# --- Application ---
APP_NAME=CollabFlow
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development                         # development | staging | production

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collabflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Constructed automatically in config.py from above values
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/collabflow

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                                 # leave empty if no password
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# --- JWT Auth ---
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- File Upload ---
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Email (future) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM=noreply@collabflow.com

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Logging ---
LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/collabflow.log
